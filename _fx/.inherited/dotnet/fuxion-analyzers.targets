<!-- Regenerated with: fx sync -->
<Project>

	<!-- The analyzers of Fuxion in the repos that use Fuxion (from oss/solution/.config/props/Analyzers.Reference.props).
	     In the workspace they are its projects; outside it they come inside the Fuxion package (WorkspaceOnly).
	     A project that must not have them (an Aspire app host) says <UseFuxionAnalyzers>false</UseFuxionAnalyzers>. -->
	<ItemGroup>
		<FxReference Include="Fuxion.Analyzers.Abstractions" WorkspaceOnly="true" ReferenceOutputAssembly="true" PrivateAssets="none" />
		<FxReference Include="Fuxion.Analyzers" WorkspaceOnly="true" ReferenceOutputAssembly="false" OutputItemType="Analyzer" PrivateAssets="all" />
		<FxReference Include="Fuxion.Analyzers.CodeFixes" WorkspaceOnly="true" ReferenceOutputAssembly="false" OutputItemType="Analyzer" PrivateAssets="all" />
	</ItemGroup>

	<!-- Visual Studio's live analysis does not build referenced projects: it needs the analyzers' dll to show their
	     diagnostics in the editor (the "force-load" of oss's old Analyzers.Reference.props). In the workspace, the path
	     comes from its map (_fx/dotnet/~$workspace.props, FxWorkspaceProject); before CoreCompile, so it reaches both the
	     compiler and CollectAnalyzersDesignTime (which runs CompileDesignTime). Only if the dll is there (built). -->
	<Target Name="FuxionAnalyzersForTheEditor" BeforeTargets="CoreCompile" Condition="'@(FxWorkspaceProject)' != ''">
		<ItemGroup>
			<_FuxionAnalyzerProject Include="@(FxWorkspaceProject)" Condition="'%(Identity)' == 'Fuxion.Analyzers' Or '%(Identity)' == 'Fuxion.Analyzers.CodeFixes'" />
			<_FuxionAnalyzerDll Include="$([System.IO.Path]::GetDirectoryName('%(_FuxionAnalyzerProject.Path)'))\bin\$(Configuration)\netstandard2.0\%(_FuxionAnalyzerProject.Identity).dll" />
			<Analyzer Include="@(_FuxionAnalyzerDll)" Condition="Exists('%(FullPath)')" Exclude="@(Analyzer)" />
		</ItemGroup>
	</Target>

</Project>
