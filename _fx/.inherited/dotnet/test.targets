<!-- Regenerated with: fx sync -->
<Project>

	<!-- The test projects, the ones that say <IsTestProject>true</IsTestProject> (from
	     oss/solution/.config/props/Project.Test.props): xUnit v3 executables on Microsoft.Testing.Platform, with
	     coverage. Imported right after the project file, so it can still make it an executable. -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
	</PropertyGroup>

	<!-- .NET Framework runs only on Windows (plan T): elsewhere (the Linux of the CI) a test project leaves its net4x out,
	     and one that has nothing else still builds but is no test application there, so dotnet test does not run it. The
	     result of a property function comes escaped: unescaped, its semicolons separate the frameworks again -->
	<PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows')) And '$(TargetFrameworks)' != ''">
		<FxTestFrameworks>$([MSBuild]::Unescape($([System.Text.RegularExpressions.Regex]::Replace(';$(TargetFrameworks);', ';net4\d+;', ';').Trim(';'))))</FxTestFrameworks>
		<TargetFrameworks Condition="'$(FxTestFrameworks)' != ''">$(FxTestFrameworks)</TargetFrameworks>
		<IsTestProject Condition="'$(FxTestFrameworks)' == ''">false</IsTestProject>
		<IsTestingPlatformApplication Condition="'$(FxTestFrameworks)' == ''">false</IsTestingPlatformApplication>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="xunit.v3" />
		<PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
	</ItemGroup>

</Project>
