<Project>

	<!--
		Fuxion.Tools.Sdk: the early part. A repo imports it from Directory.Build.props, after the properties of the area:

			<PropertyGroup>
				<FxPackable>true</FxPackable>
			</PropertyGroup>
			<Import Project="Sdk.props" Sdk="Fuxion.Tools.Sdk" />

		(<Sdk Name="Fuxion.Tools.Sdk" /> also works when the area sets nothing before.) The version comes from the
		msbuild-sdks section of the global.json at the root of the repo. The late part (Fuxion.Tools.Sdk.targets) is
		hooked in here and runs after the project file: nothing to import in Directory.Build.targets.

		Settings (all optional):
		  FxPackable              the project makes a NuGet package (docs, symbols, README, icon)
		  FxTestProject           the project is an xUnit v3 test project (Exe, xunit.v3, coverage)
		  FxPackageIconFile       icon of the packages
		  FxVersioningEnabled     version from git (default true); FxVersionFailOnError (default true),
		                          FxVersionForceCi, FxInformationalSuffix
		  FxStaticMetadataEnabled the Fx.Metadata.<Project> classes (default: as FxVersioningEnabled);
		                          FxStaticMetadataNamespace (default Fx.Metadata)
		  FxPolySharp             PolySharp on netstandard and .NET Framework (default true)
		  FxDocumentationLanguages translated XML documentation to pack, from ~$docs/<lang> (for example: es)
	-->

	<PropertyGroup>
		<FuxionToolsSdkImported>true</FuxionToolsSdkImported>

		<!-- The repo: where its global.json is (design D-33). The workspace, if the repo is mounted in one (D-36). -->
		<FxRepositoryRoot Condition="'$(FxRepositoryRoot)' == ''">$([MSBuild]::GetDirectoryNameOfFileAbove('$(MSBuildProjectDirectory)', 'global.json'))</FxRepositoryRoot>
		<FxRepositoryRoot Condition="'$(FxRepositoryRoot)' != '' And !HasTrailingSlash('$(FxRepositoryRoot)')">$(FxRepositoryRoot)\</FxRepositoryRoot>
		<FxWorkspaceRoot Condition="'$(FxWorkspaceRoot)' == '' And '$(FxRepositoryRoot)' != ''">$([MSBuild]::GetDirectoryNameOfFileAbove($([System.IO.Path]::GetFullPath('$(FxRepositoryRoot)..')), '_fx\workspace.yaml'))</FxWorkspaceRoot>
		<FxWorkspaceRoot Condition="'$(FxWorkspaceRoot)' != '' And !HasTrailingSlash('$(FxWorkspaceRoot)')">$(FxWorkspaceRoot)\</FxWorkspaceRoot>
		<!-- In a workspace a repo is mounted at <name>/repo: its name is the folder above -->
		<FxRepositoryName Condition="'$(FxRepositoryName)' == '' And '$(FxWorkspaceRoot)' != ''">$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName($(FxRepositoryRoot.TrimEnd('\'))))))</FxRepositoryName>

		<!-- Packages: <workspace>/~$publish/<repo>/nupkgs, or <repo>/~$publish/nupkgs outside a workspace (D-36) -->
		<FxPublishDirectory Condition="'$(FxPublishDirectory)' == '' And '$(FxWorkspaceRoot)' != ''">$(FxWorkspaceRoot)~$publish\$(FxRepositoryName)\</FxPublishDirectory>
		<FxPublishDirectory Condition="'$(FxPublishDirectory)' == '' And '$(FxRepositoryRoot)' != ''">$(FxRepositoryRoot)~$publish\</FxPublishDirectory>
		<PackageOutputPath Condition="'$(FxPublishDirectory)' != ''">$(FxPublishDirectory)nupkgs\</PackageOutputPath>

		<!-- Defaults of every project (from oss/solution/.config/props/Project.Default.props) -->
		<LangVersion>preview</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<WarningsAsErrors>$(WarningsAsErrors);Nullable</WarningsAsErrors>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<IsPackable Condition="'$(FxPackable)' != 'true'">false</IsPackable>

		<!-- CI -->
		<FxIsCi Condition="'$(GITHUB_ACTIONS)' == 'true' Or '$(CI)' == 'true' Or '$(CI)' == '1'">true</FxIsCi>
		<ContinuousIntegrationBuild Condition="'$(FxIsCi)' == 'true'">true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<!-- Packages (from Nuget.Metadata.props and Nuget.Config.OpenSource.props; license and URLs are the repo's) -->
	<PropertyGroup Condition="'$(FxPackable)' == 'true'">
		<IsPackable>true</IsPackable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
	</PropertyGroup>

	<!-- Test projects (from Project.Test.props) -->
	<PropertyGroup Condition="'$(FxTestProject)' == 'true'">
		<OutputType>Exe</OutputType>
	</PropertyGroup>

	<!-- Variables of the repo, generated from _fx/dotnet.yaml (design §7.3) -->
	<Import Project="$(FxRepositoryRoot)_fx\dotnet.g.props" Condition="'$(FxRepositoryRoot)' != '' And Exists('$(FxRepositoryRoot)_fx\dotnet.g.props')" />

	<!-- The late part, after the project file: in each target framework build (Microsoft.Common.targets) and in the
	     outer build of a multi-targeted project (Microsoft.Common.CrossTargeting.targets), which packs it -->
	<PropertyGroup>
		<_FxPreviousCustomBeforeDirectoryBuildTargets>$(CustomBeforeDirectoryBuildTargets)</_FxPreviousCustomBeforeDirectoryBuildTargets>
		<CustomBeforeDirectoryBuildTargets>$(MSBuildThisFileDirectory)..\build\Fuxion.Tools.Sdk.Inner.targets</CustomBeforeDirectoryBuildTargets>
		<_FxPreviousCustomAfterCrossTargetingTargets>$(CustomAfterMicrosoftCommonCrossTargetingTargets)</_FxPreviousCustomAfterCrossTargetingTargets>
		<CustomAfterMicrosoftCommonCrossTargetingTargets>$(MSBuildThisFileDirectory)..\build\Fuxion.Tools.Sdk.Outer.targets</CustomAfterMicrosoftCommonCrossTargetingTargets>
	</PropertyGroup>

</Project>
