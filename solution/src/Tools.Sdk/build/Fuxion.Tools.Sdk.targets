<Project>

	<!--
		Fuxion.Tools.Sdk: the late part, after the project file, imported by Fuxion.Tools.Sdk.Inner.targets (each target
		framework) and Fuxion.Tools.Sdk.Outer.targets (the outer build of a multi-targeted project). The when variables
		and the targets: imports of dotnet.yaml come earlier, right after the project file (Fuxion.Tools.Sdk.Project.targets).
	-->

	<!--
		References to projects of other repositories (design §6): <FxReference Include="Fuxion" />. In a workspace where
		that project is mounted, a ProjectReference; otherwise, a PackageReference (its version from the repo's packages).
		No repo has paths to another repo: the map is the workspace's _fx/~$workspace.props, generated by fx sync
		workspace, with one ProjectReference per mounted project that keeps the metadata of the FxReference.
		FxUsePackages=true makes them all packages (CI). WorkspaceOnly="true": only in the workspace, nothing outside it
		(the analyzers of oss, which its packages already carry).
	-->
	<PropertyGroup>
		<_FxWorkspaceProps Condition="'$(FxWorkspaceRoot)' != '' And '$(FxUsePackages)' != 'true'">$(FxWorkspaceRoot)_fx/~$workspace.props</_FxWorkspaceProps>
	</PropertyGroup>
	<Import Project="$(_FxWorkspaceProps)" Condition="'$(_FxWorkspaceProps)' != '' And Exists('$(_FxWorkspaceProps)')" />
	<ItemGroup Condition="'@(FxReference)' != ''">
		<_FxWorkspaceOnlyReference Include="@(FxReference->WithMetadataValue('WorkspaceOnly', 'true'))" />
		<_FxPackageReference Include="@(FxReference)" Exclude="@(FxWorkspaceProject);@(_FxWorkspaceOnlyReference)" />
		<PackageReference Include="@(_FxPackageReference)" />
	</ItemGroup>

	<!-- A repo that only builds in the workspace (FxRequiresWorkspace, design D-2) says so clearly, instead of NuGet
	     failing to find a package that does not exist -->
	<Target Name="FxCheckWorkspaceReferences"
	        BeforeTargets="_GenerateRestoreProjectSpec;CollectPackageReferences;ResolveProjectReferences"
	        Condition="'$(FxRequiresWorkspace)' == 'true' And '@(_FxPackageReference)' != ''">
		<Error Code="FX0001" Text="This repository needs the Fuxion workspace, and @(_FxPackageReference, ', ') is not mounted there (fx repo mount, fx sync)." />
	</Target>

	<PropertyGroup>
		<FxVersioningEnabled Condition="'$(FxVersioningEnabled)' == '' And '$(FxRepositoryRoot)' != ''">true</FxVersioningEnabled>
		<FxVersionFailOnError Condition="'$(FxVersionFailOnError)' == ''">true</FxVersionFailOnError>
		<FxStaticMetadataEnabled Condition="'$(FxStaticMetadataEnabled)' == ''">$(FxVersioningEnabled)</FxStaticMetadataEnabled>
		<FxStaticMetadataNamespace Condition="'$(FxStaticMetadataNamespace)' == ''">Fuxion.Metadata</FxStaticMetadataNamespace>
		<FxStaticMetadataFile>$(IntermediateOutputPath)Fuxion.StaticMetadata.g.cs</FxStaticMetadataFile>
		<FxDocumentationDirectory Condition="'$(FxDocumentationDirectory)' == ''">$(MSBuildProjectDirectory)/~$docs/</FxDocumentationDirectory>
		<_FxTasksAssembly>$(MSBuildThisFileDirectory)../tasks/net10.0/Fuxion.Tools.Sdk.dll</_FxTasksAssembly>
	</PropertyGroup>

	<!-- In process under dotnet build; on the .NET task host of MSBuild under Visual Studio (plan K, K3.1) -->
	<UsingTask TaskName="Fuxion.Tools.Sdk.FxVersion" AssemblyFile="$(_FxTasksAssembly)" Runtime="NET" />
	<UsingTask TaskName="Fuxion.Tools.Sdk.FxStaticMetadata" AssemblyFile="$(_FxTasksAssembly)" Runtime="NET" />

	<!-- ====================================================================================================== -->
	<!-- Version from git (design §9): before anything reads it, as MinVer and Nerdbank.GitVersioning do. Once per -->
	<!-- repo and build: the task caches it for the whole build.                                                -->
	<!-- ====================================================================================================== -->
	<Target Name="FxVersion"
	        BeforeTargets="GetAssemblyVersion;GenerateNuspec;_GetProjectVersion"
	        Condition="'$(FxVersioningEnabled)' == 'true' And '$(DesignTimeBuild)' != 'true'">
		<Fuxion.Tools.Sdk.FxVersion RepositoryRoot="$(FxRepositoryRoot)"
		                            FailOnError="$(FxVersionFailOnError)"
		                            ForceCi="$(FxVersionForceCi)"
		                            InformationalSuffix="$(FxInformationalSuffix)">
			<Output TaskParameter="Version" PropertyName="Version" />
			<Output TaskParameter="PackageVersion" PropertyName="PackageVersion" />
			<Output TaskParameter="AssemblyVersion" PropertyName="AssemblyVersion" />
			<Output TaskParameter="FileVersion" PropertyName="FileVersion" />
			<Output TaskParameter="InformationalVersion" PropertyName="InformationalVersion" />
		</Fuxion.Tools.Sdk.FxVersion>
		<PropertyGroup>
			<_FxVersionCalculated>true</_FxVersionCalculated>
		</PropertyGroup>
	</Target>

	<!-- ====================================================================================================== -->
	<!-- Static metadata: Fuxion.Metadata.<Project>.{Project, Build, Versioning, Repository, Json} in obj/           -->
	<!-- ====================================================================================================== -->
	<Target Name="FxStaticMetadata"
	        BeforeTargets="CoreCompile"
	        DependsOnTargets="FxVersion"
	        Condition="'$(FxStaticMetadataEnabled)' == 'true' And '$(DesignTimeBuild)' != 'true' And '$(TargetFramework)' != '' And '$(Language)' == 'C#'">
		<Fuxion.Tools.Sdk.FxStaticMetadata RepositoryRoot="$(FxRepositoryRoot)"
		                                   OutputPath="$(FxStaticMetadataFile)"
		                                   ProjectName="$(MSBuildProjectName)"
		                                   Namespace="$(FxStaticMetadataNamespace)"
		                                   TargetFramework="$(TargetFramework)"
		                                   Configuration="$(Configuration)"
		                                   VersionCalculated="$(_FxVersionCalculated)"
		                                   Version="$(Version)"
		                                   PackageVersion="$(PackageVersion)"
		                                   AssemblyVersion="$(AssemblyVersion)"
		                                   FileVersion="$(FileVersion)"
		                                   InformationalVersion="$(InformationalVersion)" />
	</Target>

	<!-- Also in design-time builds, so IntelliSense sees the classes once a build has generated them -->
	<Target Name="FxIncludeStaticMetadata"
	        BeforeTargets="CoreCompile"
	        AfterTargets="FxStaticMetadata"
	        Condition="'$(FxStaticMetadataEnabled)' == 'true' And '$(TargetFramework)' != '' And '$(Language)' == 'C#'">
		<ItemGroup Condition="Exists('$(FxStaticMetadataFile)')">
			<Compile Include="$(FxStaticMetadataFile)" Visible="false" />
			<FileWrites Include="$(FxStaticMetadataFile)" />
		</ItemGroup>
	</Target>

	<!-- ======================================================================================================= -->
	<!-- Translated documentation (FxDocumentationLanguages): a feature of the tool, only when asked for           -->
	<!-- ======================================================================================================= -->
	<PropertyGroup Condition="'$(FxDocumentationLanguages)' != '' And '$(IsPackable)' == 'true'">
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);FxIncludeTranslatedDocumentation</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>

	<!-- The English XML documentation is copied to ~$docs/en for the translators; ~$docs/<lang>/<Assembly>.xml is
	     packed for each language of FxDocumentationLanguages (from oss/solution/.config/targets/Documentation.targets) -->
	<!-- Only the first target framework copies it: the builds of each framework run in parallel and the file would be
	     contended (and it is the same documentation) -->
	<Target Name="FxCopyEnglishDocumentation"
	        AfterTargets="CoreCompile"
	        Condition="'$(GenerateDocumentationFile)' == 'true' And '$(TargetFramework)' != '' And '$(FxDocumentationLanguages)' != ''
	                   And ('$(TargetFrameworks)' == '' Or $(TargetFrameworks.Trim().StartsWith('$(TargetFramework)')))">
		<Copy SourceFiles="@(DocFileItem)" DestinationFolder="$(FxDocumentationDirectory)en" SkipUnchangedFiles="true" Condition="Exists('@(DocFileItem)')" />
	</Target>

	<Target Name="FxIncludeTranslatedDocumentation">
		<ItemGroup>
			<_FxDocumentationLanguage Include="$(FxDocumentationLanguages)" />
			<TfmSpecificPackageFile Include="$(FxDocumentationDirectory)%(_FxDocumentationLanguage.Identity)/$(AssemblyName).xml"
			                        PackagePath="lib/$(TargetFramework)/%(_FxDocumentationLanguage.Identity)"
			                        Condition="Exists('$(FxDocumentationDirectory)%(_FxDocumentationLanguage.Identity)/$(AssemblyName).xml')" />
		</ItemGroup>
	</Target>

</Project>
