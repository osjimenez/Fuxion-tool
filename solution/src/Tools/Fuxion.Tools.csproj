<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>$(LatestCoreFramework)</TargetFramework>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>fx</ToolCommandName>
		<!-- the executable is fx (fx.exe), as the command (design D-24) -->
		<AssemblyName>fx</AssemblyName>
		<PackageId>Fuxion.Tools</PackageId>
		<!-- until the tool versions itself (K4) -->
		<Version>0.1.0-local</Version>
		<!-- native AOT, a single file (design §11) -->
		<PublishAot>true</PublishAot>
		<InvariantGlobalization>true</InvariantGlobalization>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Tools.Core\Fuxion.Tools.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Spectre.Console" />
		<PackageReference Include="System.CommandLine" />
	</ItemGroup>

</Project>
