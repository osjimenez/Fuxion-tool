<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>$(LatestCoreFramework)</TargetFramework>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>fx</ToolCommandName>
		<!-- the executable is fx (fx.exe), as the command (design D-24) -->
		<AssemblyName>fx</AssemblyName>
		<PackageId>Fuxion.Tools</PackageId>
		<PackageVersion>0.1.0-local</PackageVersion>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Tools.Core\Fuxion.Tools.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Spectre.Console" />
		<PackageReference Include="System.CommandLine" />
	</ItemGroup>

</Project>
