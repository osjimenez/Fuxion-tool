<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Fuxion.Tool.Sdk, the MSBuild SDK of the Fuxion repos (design §7, D-35). A repo pins it in global.json
		(msbuild-sdks) and imports it with <Sdk Name="Fuxion.Tool.Sdk" /> in its Directory.Build.props.
		The tasks run on the .NET task host of MSBuild (UsingTask Runtime="NET"): in process under dotnet build, out of
		process under Visual Studio (plan K, K3.1). This project follows the MSBuild it builds against: Microsoft.Build.Utilities.Core
		18.11 is the line of .NET 11 and does not support net10.0, so the tasks are net11.0 and need the .NET 11 SDK (plan O,
		its close), and so is Core, which goes in tasks/ with them.
	-->

	<PropertyGroup>
		<TargetFramework>$(LatestCoreFramework)</TargetFramework>
		<PackageId>Fuxion.Tool.Sdk</PackageId>
		<Description>MSBuild SDK of fx, the tool of Fuxion's spaces: versioning from git, static metadata, references between repositories and what fx generates from dotnet.yaml. It adds its own Fx* settings and leaves the rest of the build to the repository.</Description>
		<PackageType>MSBuildSdk</PackageType>
		<!-- the tasks and everything they need go to tasks/net11.0; the package has no dependencies -->
		<BuildOutputTargetFolder>tasks</BuildOutputTargetFolder>
		<SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);_FxIncludeTaskDependencies</TargetsForTfmSpecificBuildOutput>
		<!-- NU5100: the assemblies are in tasks/, not lib/, on purpose; NU5128: no lib/ to match the dependencies -->
		<NoWarn>$(NoWarn);NU5100;NU5128</NoWarn>
		<!-- what a repo uses is its MSBuild properties (Sdk/Sdk.props says them), not these classes: no XML documentation -->
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Build.Utilities.Core" PrivateAssets="all" ExcludeAssets="runtime" />
		<ProjectReference Include="..\Tool.Core\Fuxion.Tool.Core.csproj" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Sdk\**" Pack="true" PackagePath="Sdk" />
		<None Include="build\**" Pack="true" PackagePath="build" />
	</ItemGroup>

	<!-- Core, Fuxion and the rest of the copy-local assemblies next to the tasks (MSBuild provides its own) -->
	<Target Name="_FxIncludeTaskDependencies" DependsOnTargets="ResolveReferences">
		<ItemGroup>
			<BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)"
			                      TargetPath="%(ReferenceCopyLocalPaths.DestinationSubDirectory)%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension)"
			                      Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll' And !$([System.String]::Copy('%(Filename)').StartsWith('Microsoft.Build'))" />
		</ItemGroup>
	</Target>

</Project>
