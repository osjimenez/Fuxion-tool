<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- as the SDK tasks that load it and fx: inside the exe of fx, and in tasks/ of the package of the SDK -->
		<TargetFramework>$(LatestCoreFramework)</TargetFramework>
		<!-- fx is published with native AOT: the analyzers keep this library free of trimming and AOT warnings -->
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Fuxion" />
		<!-- only its parser, read into fx's own tree with positions (Yaml/YamlDocument.cs): no reflection, so AOT-compatible -->
		<PackageReference Include="SharpYaml" />
	</ItemGroup>

</Project>
