{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fuxion.invalid/document/v1.0/base.schema.json",
  "title": "Document document metadata base 1.0",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "$ref": "common.schema.json#/$defs/uuid" },
    "type": {
      "type": "string",
      "enum": [
        "adr",
        "design",
        "plan",
        "readme",
        "reference",
        "register",
        "report",
        "research",
        "rfc",
        "rule",
        "runbook",
        "spec",
        "view"
      ]
    },
    "status": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/tag" },
      "uniqueItems": true
    },
    "createdAt": { "$ref": "common.schema.json#/$defs/utcInstant" },
    "updatedAt": { "$ref": "common.schema.json#/$defs/utcInstant" },
    "createdBy": { "$ref": "common.schema.json#/$defs/actorId" },
    "relations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/relation" },
      "uniqueItems": true
    },
    "integrity": { "$ref": "common.schema.json#/$defs/integrity" }
  },
  "required": [
    "schemaVersion",
    "id",
    "type",
    "status",
    "title",
    "createdAt",
    "updatedAt",
    "createdBy",
    "integrity"
  ]
}
