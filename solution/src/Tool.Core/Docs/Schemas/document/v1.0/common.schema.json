{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fuxion.invalid/document/v1.0/common.schema.json",
  "title": "Document document metadata common definitions 1.0",
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "utcInstant": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "actorId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "tag": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\).+$",
      "not": { "pattern": "(^|/)\\.\\.(/|$)" }
    },
    "relationKind": {
      "type": "string",
      "enum": [
        "amends",
        "constrains",
        "decided-by",
        "depends-on",
        "derived-from",
        "governs",
        "implemented-by",
        "indexes",
        "informs",
        "operated-by",
        "realized-by",
        "related-to",
        "summarizes",
        "supersedes",
        "verified-by"
      ],
      "x-docs-relation-rules": {
        "decided-by": { "targets": ["adr"] },
        "implemented-by": { "targets": ["plan"] },
        "operated-by": { "targets": ["runbook"] },
        "realized-by": { "sources": ["spec"], "targets": ["design"] },
        "summarizes": { "sources": ["report", "view"] }
      }
    },
    "relation": {
      "type": "object",
      "properties": {
        "kind": { "$ref": "#/$defs/relationKind" },
        "targetId": { "$ref": "#/$defs/uuid" }
      },
      "required": ["kind", "targetId"],
      "additionalProperties": false
    },
    "generation": {
      "type": "object",
      "properties": {
        "recipe": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[._/-][a-z0-9]+)*$"
        },
        "scope": { "$ref": "#/$defs/relativePath" }
      },
      "required": ["recipe", "scope"],
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "$ref": "#/$defs/tag" },
        "key": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-(?:[0-9]+|~[0-9a-f]{4})$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
        "status": { "$ref": "#/$defs/tag" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "tags": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/tag" },
          "uniqueItems": true
        },
        "createdAt": { "$ref": "#/$defs/utcInstant" },
        "closedAt": { "$ref": "#/$defs/utcInstant" },
        "relations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/relation" },
          "uniqueItems": true
        },
        "fields": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/tag" },
          "additionalProperties": {
            "anyOf": [
              { "type": ["string", "number", "boolean"] },
              { "type": "array", "items": { "type": ["string", "number", "boolean"] } }
            ]
          }
        }
      },
      "required": ["id", "name", "title", "status", "createdAt"],
      "additionalProperties": false
    },
    "integrity": {
      "type": "object",
      "properties": {
        "content": { "$ref": "#/$defs/digest" },
        "metadata": { "$ref": "#/$defs/digest" }
      },
      "required": ["content", "metadata"],
      "additionalProperties": false
    }
  }
}
