{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fuxion.invalid/document/v1.0/types/readme.schema.json",
  "title": "Document readme metadata 1.0",
  "x-docs-temporality": "stable",
  "x-docs-status-classes": { "active": "current", "retired": "void" },
  "allOf": [
    { "$ref": "../base.schema.json" },
    {
      "type": "object",
      "properties": {
        "type": { "const": "readme" },
        "status": { "enum": ["active", "retired"] }
      }
    }
  ],
  "unevaluatedProperties": false
}
