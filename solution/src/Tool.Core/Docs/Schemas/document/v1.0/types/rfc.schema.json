{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fuxion.invalid/document/v1.0/types/rfc.schema.json",
  "title": "Document RFC metadata 1.0",
  "x-docs-temporality": "historical",
  "x-docs-status-classes": { "accepted": "closed", "draft": "open", "rejected": "void", "review": "open", "superseded": "replaced", "withdrawn": "void" },
  "allOf": [
    { "$ref": "../base.schema.json" },
    {
      "type": "object",
      "properties": {
        "type": { "const": "rfc" },
        "status": { "enum": ["accepted", "draft", "rejected", "review", "superseded", "withdrawn"] }
      }
    }
  ],
  "unevaluatedProperties": false
}
