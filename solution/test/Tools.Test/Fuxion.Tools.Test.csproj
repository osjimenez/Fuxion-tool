<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>$(LatestCoreFramework)</TargetFramework>
		<!-- xUnit v3 test projects are executables, run on Microsoft.Testing.Platform (global.json) -->
		<OutputType>Exe</OutputType>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="xunit.v3" />
		<PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
	</ItemGroup>

	<ItemGroup>
		<!-- the YAML edit engine checks run on copies of the workspace files (YamlEditorTest) -->
		<None Include="YamlFixtures\*.yaml" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Tools.Core\Fuxion.Tools.Core.csproj" />
		<!-- the CLI runs in process (FxApp.Run) -->
		<ProjectReference Include="..\..\src\Tools\Fuxion.Tools.csproj" />
		<!-- built before the tests, which pack it (SdkFixture) -->
		<ProjectReference Include="..\..\src\Tools.Sdk\Fuxion.Tools.Sdk.csproj" ReferenceOutputAssembly="false" />
	</ItemGroup>

</Project>
