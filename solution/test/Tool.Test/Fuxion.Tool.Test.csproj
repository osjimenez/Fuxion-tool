<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>$(LatestCoreFramework)</TargetFramework>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>

	<ItemGroup>
		<!-- the YAML edit engine checks run on copies of real configuration files of fx, in their old format (YamlEditorTest) -->
		<None Include="YamlFixtures\*.yaml" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Tool.Core\Fuxion.Tool.Core.csproj" />
		<!-- the CLI runs in process (FxApp.Run) -->
		<ProjectReference Include="..\..\src\Tool\Fuxion.Tool.csproj" />
		<!-- built before the tests, which pack it (SdkFixture) -->
		<ProjectReference Include="..\..\src\Tool.Sdk\Fuxion.Tool.Sdk.csproj" ReferenceOutputAssembly="false" />
	</ItemGroup>

</Project>
