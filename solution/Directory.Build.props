<Project>

	<!--
		This repo builds with its own SDK, like the other repos of the workspace (design §7.1): the version it published
		before, pinned in global.json (fx sync, from the sdks: of the workspace's _fx/dotnet/dotnet.yaml). The conventions
		(frameworks, language, warnings, tests, packages) come from that dotnet.yaml (_fx/.inherited/, _fx/dotnet/*.g.*).
	-->

	<!-- Its packages: the SDK (fx as a dotnet tool, with the release), open source (their license, from the workspace's
	     package-oss.targets); before the SDK, so that packable.props applies -->
	<PropertyGroup>
		<IsPackable Condition="'$(MSBuildProjectName)' == 'Fuxion.Tools.Sdk'">true</IsPackable>
		<FuxionPackage>oss</FuxionPackage>
	</PropertyGroup>
	<Import Project="Sdk.props" Sdk="Fuxion.Tools.Sdk" />

</Project>
